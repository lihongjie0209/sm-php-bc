{
    "name": "sm-bc/sm-php-bc",
    "description": "SM2/SM3/SM4 implementation in PHP based on Bouncy Castle",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SmBc\\": "src/",
            "Rtgm\\SmPhpBc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmBc\\Tests\\": "tests/",
            "Rtgm\\SmPhpBc\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-gmp": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}